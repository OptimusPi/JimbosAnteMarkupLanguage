<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPublishable>false</IsPublishable>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateProgramFile>false</GenerateProgramFile>
    <Version>$(MotelyVersion)</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Trim, AOT and single-file analyzers on every build; with TreatWarningsAsErrors, code that
         would break under NativeAOT fails the build here, not in someone's published app. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- White-box tests are the only friend assembly. Tools and hosts use the public API:
         JamlSchemaGenerator for schema files, JamlConfig/MotelySearchBuilder/Jamlyzer for clients,
         and the MCP server (Motely.Mcp) uses those same public types. -->
    <InternalsVisibleTo Include="Motely.Tests" />
  </ItemGroup>

  <!-- Packages (versions from Directory.Packages.props) -->
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" />
  </ItemGroup>
</Project>
